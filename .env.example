# Copy to .env and adjust. Nothing in this file is a real credential.
# The app reads these directly from the environment; no .env loader is required.

# --- Database -------------------------------------------------------------
# Either set DATABASE_URL, or set the individual values below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_management_app_development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=event_management_app_development
TEST_DATABASE_NAME=event_management_app_test

# --- Rails ----------------------------------------------------------------
RAILS_ENV=development
RAILS_MAX_THREADS=5
PORT=3000
# Required in production. Generate with: bin/rails secret
# SECRET_KEY_BASE=

# --- Application ----------------------------------------------------------
# Largest page size the events API will return (default 100).
EVENTS_MAX_PAGE_SIZE=100
# Where "user joined your event" notifications go: log | noop
EVENT_NOTIFIER=log
# Password used by db/seeds.rb for the sample accounts.
SEED_PASSWORD=password123
