<% content_for :title, 'Events' %>
<div class="container py-4" data-controller="events" data-action-name="index">
  <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
      <p class="page-kicker mb-1">What's on</p>
      <h1 class="h2 mb-1">Events</h1>
      <p class="text-secondary mb-0" data-events-target="summary" aria-live="polite">Loading events&hellip;</p>
    </div>
    <button type="button" class="btn btn-primary" data-action="click->events#create">
      New event
    </button>
  </div>

  <div class="board">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <caption class="visually-hidden">Upcoming and past events, earliest first</caption>
        <thead>
          <tr>
            <th scope="col" style="width: 7rem">Starts</th>
            <th scope="col">Event</th>
            <th scope="col">Location</th>
            <th scope="col">Organizer</th>
            <th scope="col" class="text-center">Attendees</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody data-events-target="tableBody"></tbody>
      </table>
    </div>

    <div class="p-5 text-center text-secondary d-none" data-events-target="emptyState">
      <p class="h5 mb-1">Nothing on the board yet</p>
      <p class="mb-0">Create the first event and it will show up here.</p>
    </div>

    <div class="p-5 text-center text-danger d-none" data-events-target="errorState" role="alert">
      <p class="mb-0 fw-semibold">Could not load events. Please refresh the page.</p>
    </div>
  </div>

  <nav class="d-flex justify-content-between align-items-center mt-3 d-none" aria-label="Events pages"
       data-events-target="pager">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->events#previousPage"
            data-events-target="previousButton">&larr; Previous</button>
    <span class="small text-secondary" data-events-target="pageLabel"></span>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->events#nextPage"
            data-events-target="nextButton">Next &rarr;</button>
  </nav>
</div>

<%= render 'events/forms/show' %>
<%= render 'events/forms/create' %>
