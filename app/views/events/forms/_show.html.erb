<div class="modal fade" id="showEventModal" tabindex="-1" aria-labelledby="show-event-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="show-event-title"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <p id="show-event-description" class="text-body-secondary"></p>
        <dl class="row mb-0 small">
          <dt class="col-4">Starts</dt><dd class="col-8" id="show-event-date"></dd>
          <dt class="col-4">Location</dt><dd class="col-8" id="show-event-location"></dd>
          <dt class="col-4">Organizer</dt><dd class="col-8" id="show-event-organizer"></dd>
          <dt class="col-4">Attendees</dt><dd class="col-8" id="show-event-attendees"></dd>
        </dl>
      </div>
    </div>
  </div>
</div>
