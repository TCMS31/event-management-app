<% content_for :title, 'Your account' %>
<div class="container">
  <div class="auth-card">
    <h1 class="h3 mb-4">Your account</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div class="mb-3">
        <%= f.label :email, class: 'form-label' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true, class: 'form-control' %>
      </div>

      <div class="mb-3">
        <%= f.label :password, 'New password', class: 'form-label' %>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'form-control',
                                        aria: { describedby: 'new-password-hint' } %>
        <div id="new-password-hint" class="form-text">
          Leave blank to keep your current password.
          <% if @minimum_password_length %><%= @minimum_password_length %> characters minimum.<% end %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, 'Confirm new password', class: 'form-label' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'form-control' %>
      </div>

      <div class="mb-4">
        <%= f.label :current_password, class: 'form-label' %>
        <%= f.password_field :current_password, autocomplete: 'current-password', required: true,
                                                class: 'form-control', aria: { describedby: 'current-password-hint' } %>
        <div id="current-password-hint" class="form-text">Needed to confirm any change.</div>
      </div>

      <%= f.submit 'Save changes', class: 'btn btn-primary w-100' %>
    <% end %>

    <hr class="my-4">

    <h2 class="h6">Delete account</h2>
    <p class="small text-secondary">Removes your account, the events you organise and every event you joined.</p>
    <%= button_to 'Delete my account', registration_path(resource_name), method: :delete,
                  class: 'btn btn-sm btn-outline-danger',
                  data: { turbo_confirm: 'Delete your account and your events? This cannot be undone.' } %>

    <p class="mt-4 mb-0 small"><%= link_to 'Back to events', root_path %></p>
  </div>
</div>
